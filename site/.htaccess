# Compression des réponses texte (corpus.json pèse environ 2 Mo non compressé).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
# Le corpus change à chaque publication : demander une revalidation plutôt qu'un cache long.
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
